{
  "name": "portuguese-mvp",
  "private": true,
  "scripts": {
    "dev": "node run-next.mjs dev",
    "build": "next build",
    "start": "node run-next.mjs start",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local seed-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local migrate-profile.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
